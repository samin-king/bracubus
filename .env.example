NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bracu:local-development-only@localhost:5432/bracu
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
BRACU_STUDENT_EMAIL_DOMAIN=g.bracu.ac.bd
# Optional full-email regex, only if a stricter student format is agreed.
BRACU_STUDENT_EMAIL_PATTERN=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
TRUST_PROXY=false
POSTGRES_DB=bracu
POSTGRES_USER=bracu
POSTGRES_PASSWORD=local-development-only
# Booking reads scheduled Member 3 trips directly from PostgreSQL.
# Supported booking departure times: 06:30, 08:30, 14:00, 17:00 (Asia/Dhaka).

API_PORT=3000
NODE_ENV=development
DEV_EMAIL_LOGIN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ENABLE_DEV_DRIVER_AUTH=false
DEV_DRIVER_ID=1
REDIS_URL=redis://localhost:6379
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000

# Explicit loopback-only direct student login. Never enable in production.
DEV_DIRECT_LOGIN=false
