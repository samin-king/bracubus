# Set real values in Vercel > Project > Settings > Environment Variables.
# Required: actual hosted PostgreSQL URL, publicly reachable from Vercel.
# Preserve the provider's required TLS options. No provider-specific API is used.
DATABASE_URL=
# Required: stable random session-signing secret, at least 32 characters.
SESSION_SECRET=

NODE_ENV=production
DEV_DIRECT_LOGIN=false
DEV_EMAIL_LOGIN=false
ENABLE_DEV_DRIVER_AUTH=false
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_TTL_HOURS=8

# Optional on Vercel: derived from trusted Vercel system environment variables.
# Override only for your exact custom/canonical HTTPS origin (no path).
# Do not reuse a production override for preview deployments.
FRONTEND_URL=

# Optional at startup, required for working secure email-link login.
# Use a provider-authorized sender that can deliver to your BRACU inboxes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional Google endpoints only. Leave all three unset for normal email login.
# If enabling OAuth, supply both credentials and a valid HTTPS callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional additional full-email regex; default BRACU rules remain enforced.
BRACU_STUDENT_EMAIL_PATTERN=
# PORT, Redis, demo emails and separate backend URLs are not needed on Vercel.
